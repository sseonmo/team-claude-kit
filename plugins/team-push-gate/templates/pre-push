#!/usr/bin/env bash
# managed by team-push-gate
# 원본: sseonmo/team-claude-kit plugins/team-push-gate/templates/pre-push
# push 되는 커밋 범위를 Claude Code 의 /code-review 로 검토하고, FAIL 이면 push 를 막는다.
#   - PR 을 열려면 반드시 push 해야 하므로 실질적으로 PR 앞단 게이트다.
#   - fail-closed: 리뷰를 못 돌리거나 판정을 못 얻으면 **막는다.**
#     게이트가 조용히 무력화되는 것보다 시끄럽게 막히는 편이 낫다는 선택(2026-08-07).
#   - 우회: SKIP_AI_REVIEW=1 git push   또는   git push --no-verify
#
# stdin: <local ref> <local sha> <remote ref> <remote sha>   (push 되는 ref 마다 한 줄)
# $1: remote 이름   $2: remote URL

set -uo pipefail

# 600 → 350 (2026-08-08). 실측 28건 분포에서 고른 값이다.
#   300 으로 하면 완료된 리뷰 25건 중 2건(315.7s·330.2s)이 정상 PASS 인데 차단된다.
#   350 이면 폭주 1건(596.7s — 리뷰어가 claude.exe 를 디스어셈블하며 271초를 태웠다)만 잘리고
#   정상 리뷰 손실은 0이다. 350 위로는 개선이 없어 450 을 고를 이유가 없다.
# 컷은 값싼 리뷰가 아니라 비싼 리뷰를 먼저 죽인다 — 오래 걸린 리뷰들이 두 커밋을 나란히
# 실행해 비교하던 것들이었고, 게이트의 유일한 실제 성과도 277.7초에서 나왔다.
# fail-closed 라 이 값을 넘으면 차단된다.
TIMEOUT_SEC=350
remote="${1:-origin}"
ZERO=0000000000000000000000000000000000000000

say() { printf '%s\n' "$*" >&2; }

if [ "${SKIP_AI_REVIEW:-}" = "1" ]; then
  say "⏭  [pre-push] SKIP_AI_REVIEW=1 — 리뷰를 건너뜁니다."
  exit 0
fi

# --- push 되는 범위 계산 ---
ranges=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue           # 브랜치 삭제 push 는 대상 아님
  if [ "$remote_sha" = "$ZERO" ]; then
    # 새 브랜치 — 원격에 비교 대상이 없으니 기본 브랜치와의 merge-base 부터 본다
    base=$(git merge-base "$local_sha" "$remote/HEAD" 2>/dev/null \
        || git merge-base "$local_sha" origin/main 2>/dev/null \
        || git merge-base "$local_sha" origin/master 2>/dev/null \
        || git rev-list --max-parents=0 "$local_sha" | tail -1)
  else
    base="$remote_sha"
  fi
  [ -z "${base:-}" ] && continue
  ranges="${ranges:+$ranges }$base..$local_sha"
done

[ -z "$ranges" ] && exit 0

# --- 발동 조건: 문서(.md)만 바뀌었으면 리뷰하지 않는다 ---
files=$(for r in $ranges; do git diff --name-only "$r" 2>/dev/null; done | sort -u)
[ -z "$files" ] && exit 0
if ! printf '%s\n' "$files" | grep -qv '\.md$'; then
  say "⏭  [pre-push] 문서(.md)만 변경되어 리뷰를 건너뜁니다."
  exit 0
fi

# --- claude 탐색: 훅 셸의 PATH 는 빈약해서 직접 찾는다 ---
CLAUDE=""
for c in claude /opt/homebrew/bin/claude /usr/local/bin/claude "$HOME/.local/bin/claude"; do
  if command -v "$c" >/dev/null 2>&1; then CLAUDE=$(command -v "$c"); break; fi
done
if [ -z "$CLAUDE" ]; then
  # nvm 설치는 노드 버전이 바뀌면 경로가 달라진다 — 최신 것을 쓴다
  CLAUDE=$(ls -t "$HOME"/.nvm/versions/node/*/bin/claude 2>/dev/null | head -1)
fi
if [ -z "$CLAUDE" ]; then
  say "❌ [pre-push] claude CLI 를 찾지 못했습니다 — 리뷰를 돌릴 수 없어 push 를 막습니다."
  say "   우회: SKIP_AI_REVIEW=1 git push   또는   git push --no-verify"
  exit 1
fi

TIMEOUT=""
command -v timeout >/dev/null 2>&1 && TIMEOUT="timeout $TIMEOUT_SEC"

say "🔍 [pre-push] /code-review 실행 중 — $ranges (최대 ${TIMEOUT_SEC}초)"

# bypassPermissions: 이게 없으면 리뷰어가 파일을 못 읽어 "승인이 거부되어 확인 못 했음" 수준의
# 리뷰만 나온다. 대가로 push 마다 리뷰어에게 도구 권한을 전부 준다는 점은 인지하고 쓴다.
out=$($TIMEOUT "$CLAUDE" -p "/code-review

리뷰 대상은 이번 push 로 올라가는 커밋 범위다: $ranges
(\`git diff $ranges\` 로 확인할 수 있다. 이 범위 밖의 변경과 미커밋 작업트리는 무시하라)
여러 커밋의 누적이므로, 중간 커밋에서 생겼다가 뒤 커밋에서 이미 고쳐진 문제는 보고하지 마라.

리뷰를 마치면 마지막 줄에 'VERDICT: PASS' 또는 'VERDICT: FAIL' 만 출력하라.
FAIL 은 이대로 PR 에 올리면 안 되는 심각한 결함이 있을 때만 쓴다.
스타일·네이밍·설계 취향은 FAIL 이 아니다 — PASS 로 하고 본문에 적어라.

지적할 것이 없으면 '지적 없음' 한 줄만 쓰고 VERDICT 로 넘어가라. 그게 정상적인 결과이고,
실제로 자주 나와야 하는 결과다. 빈칸을 채우려고 사소한 것을 적지 마라 — 적을지 말지의
기준은 '안 고치면 나중에 문제가 되는가' 하나다. 그 기준을 넘지 않는 것은 아예 쓰지 마라.
'참고로', '사소하지만', '결함은 아니지만' 으로 시작하는 항목은 대부분 그 기준을 넘지 않는다." \
  --permission-mode bypassPermissions </dev/null 2>&1)
rc=$?

printf '%s\n' "$out" >&2

if [ $rc -ne 0 ]; then
  if [ $rc -eq 124 ]; then
    say "❌ [pre-push] 리뷰가 ${TIMEOUT_SEC}초 타임아웃 — 판정 없이 넘어가지 않습니다."
  else
    say "❌ [pre-push] 리뷰 실행 실패(exit $rc) — 판정 없이 넘어가지 않습니다."
  fi
  say "   우회: SKIP_AI_REVIEW=1 git push   또는   git push --no-verify"
  exit 1
fi

verdict=$(printf '%s' "$out" | grep -oE 'VERDICT:[[:space:]]*(PASS|FAIL)' | tail -1)
case "$verdict" in
  *PASS)
    say "✅ [pre-push] 리뷰 통과 — push 를 진행합니다."
    exit 0 ;;
  *FAIL)
    say "❌ [pre-push] 리뷰가 심각한 결함을 지적했습니다 — push 를 중단합니다. 위 내용을 확인하세요."
    say "   강행하려면: SKIP_AI_REVIEW=1 git push   또는   git push --no-verify"
    exit 1 ;;
  *)
    say "⚠️  [pre-push] VERDICT 줄을 찾지 못해 판정할 수 없습니다 — 안전을 위해 push 를 막습니다."
    say "   우회: SKIP_AI_REVIEW=1 git push   또는   git push --no-verify"
    exit 1 ;;
esac
